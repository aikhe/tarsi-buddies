{
  "name": "tarsi-buddies",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "bun run prettier && bun run lint",
    "lint": "bun run lint:js && bun run lint:css",
    "lint:js": "eslint \"**/*.{js,mjs,ts,tsx}\"",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --cache --cache-strategy=content --cache-location=.stylelintcache",
    "lint:fix": "eslint \"**/*.{js,mjs,ts,tsx}\" --fix && stylelint \"**/*.css\" --fix",
    "format": "bun run prettier:fix && bun run lint:fix",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,json,yml,css,md,html}\" --check --cache --cache-strategy=content --cache-location=.prettiercache",
    "prettier:fix": "bun run prettier -- --write",
    "test": "vitest run",
    "test:unit": "vitest"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  }
}
